DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
CLIENT_ORIGIN=
# Optional public web origin used by verification/reset links (for example a local Wi-Fi web URL).
# This exact origin is also trusted for browser API requests; production must use HTTPS.
ACCOUNT_LINK_ORIGIN=
PORT=
NODE_ENV=
TRUST_PROXY=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
# Optional ordered backups. Set to none to disable fallback.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# Account emails: choose an SMTP provider, verify the sender, then configure these.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Per-user title limit; new uploaded covers are capped at 256 KB.
COLLECTION_LIMIT=500
# Persisted, shared across API processes; budgets reset at 00:00 UTC.
ASSISTANT_DAILY_GENERATIONS=100
ASSISTANT_DAILY_BUDGET_USD=5
# Set conservative maximum prices covering ALL configured primary/fallback models.
# Amounts are USD per million tokens. Verify provider pricing before production.
ASSISTANT_INPUT_USD_PER_MILLION=6
ASSISTANT_OUTPUT_USD_PER_MILLION=30
